generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://u351811476_ivonnemarin:O9e44y6fXp@127.0.0.1:3306/u351811476_ivonnemarin"
}

model User {
  id          String   @id @default(uuid())
  name        String?
  email       String   @unique
  password    String
  role        String   @default("ADMIN") // ADMIN or AGENT
  permissions         String?  // JSON array like ["inmuebles", "leads", "agenda", "blog", "reportes", "configuracion"]
  image               String?
  emailChanged        Boolean  @default(false)
  isActive            Boolean  @default(true)
  verificationCode    String?
  verificationExpiry  DateTime?
  avatarGenerationsCount Int @default(0)
  lastAvatarGeneration   DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Property {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  internalCode    String?  @unique
  shortDesc       String?  @db.Text
  fullDesc        String?  @db.LongText
  modality        String   // "VENTA" or "ARRIENDO"
  propertyType    String   // e.g., "Apartamento", "Casa"
  status          String   @default("DISPONIBLE") // "DISPONIBLE", "NO_DISPONIBLE"
  price           Float
  currency        String   @default("COP")
  city            String
  sector          String?
  address         String?
  lat             Float?
  lng             Float?
  builtArea       Float?
  lotArea         Float?
  bedrooms        Int?
  bathrooms       Int?
  parking         Int?
  stratum         Int?     // Estrato
  antiquity       Int?     // Años
  adminFee        Float?   // Administración
  amenities       String?  @db.Text // JSON string or comma separated
  features        String?  @db.Text // JSON string or comma separated
  mainImage       String?
  images          String?  @db.LongText // JSON array
  videos          String?  @db.LongText // JSON array
  virtualTour     String?  @db.Text
  documents       String?  @db.LongText // JSON array
  isFeatured      Boolean  @default(false)
  isInvestment    Boolean  @default(false)
  seoTitle        String?
  seoDesc         String?  @db.Text
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  appointments    Appointment[]
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  summary     String?  @db.Text
  content     String   @db.LongText
  mainImage   String?
  author      String?
  category    String?
  tags        String?  // comma separated
  status      String   @default("DRAFT") // "DRAFT" or "PUBLISHED"
  seoTitle    String?
  seoDesc     String?  @db.Text
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id          String   @id @default(uuid())
  type        String   // "CONTACT", "VISIT", "SELL", "RENT"
  name        String
  email       String
  phone       String?
  message     String?
  propertyId  String?
  status      String   @default("NEW") // "NEW", "CONTACTED", "CLOSED"
  avatar      String?  // URL of the uploaded image or selected avatar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
}

model Appointment {
  id          String   @id @default(uuid())
  leadId      String
  propertyId  String?
  date        DateTime
  coverImage  String?
  status      String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  lead        Lead     @relation(fields: [leadId], references: [id])
  property    Property? @relation(fields: [propertyId], references: [id])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  content   String
  rating    Int      @default(5)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
